#compdef kirisute

_kirisute() {
  local -a commands
  commands=(
    'doctor:check the tools kirisute needs'
    'version:print the version'
    'help:print usage'
  )

  if (( CURRENT == 2 )) && [[ "${words[2]}" != -* ]]; then
    _alternative 'commands:command:_describe command commands' 'roms:rom:_files -g "*.(nds|NDS|gba|GBA)(-.)" -g "*(-/)"'
    return
  fi

  _arguments \
    '--dry-run[list what would be trimmed and change nothing]' \
    "--info[print each ROM's header and change nothing]" \
    '--verify[trim only a ROM whose padding holds nothing but 00 or FF]' \
    '--no-verify[trim whatever the padding holds]' \
    '--backup[keep each original as <rom>.bak]' \
    '--no-backup[keep no copy of the original]' \
    '--recursive[look for ROM files in every subfolder too]' \
    '--json[print the result as one JSON object, for scripts]' \
    '*:rom:_files -g "*.(nds|NDS|gba|GBA)(-.)" -g "*(-/)"'
}

_kirisute "$@"
