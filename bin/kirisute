#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh

for ks_inherited in $(env | sed -n 's/^\(KS_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "${ks_inherited}"
done

ks_self="$0"
case "${ks_self}" in
*/*) ;;
*) ks_self="$(command -v -- "${ks_self}")" ;;
esac
KS_LIB="$(cd "${ks_self%/*}/../lib" && pwd)" || exit 1

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${KS_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/ui.sh
. "${KS_LIB}/ui.sh"
# shellcheck source=SCRIPTDIR/../lib/cli.sh
. "${KS_LIB}/cli.sh"
# shellcheck source=SCRIPTDIR/../lib/doctor.sh
. "${KS_LIB}/doctor.sh"
# shellcheck source=SCRIPTDIR/../lib/args.sh
. "${KS_LIB}/args.sh"
# shellcheck source=SCRIPTDIR/../lib/rom.sh
. "${KS_LIB}/rom.sh"
# shellcheck source=SCRIPTDIR/../lib/nds.sh
. "${KS_LIB}/nds.sh"
# shellcheck source=SCRIPTDIR/../lib/gba.sh
. "${KS_LIB}/gba.sh"
# shellcheck source=SCRIPTDIR/../lib/3ds.sh
. "${KS_LIB}/3ds.sh"
# shellcheck source=SCRIPTDIR/../lib/cxi.sh
. "${KS_LIB}/cxi.sh"
# shellcheck source=SCRIPTDIR/../lib/psp.sh
. "${KS_LIB}/psp.sh"
# shellcheck source=SCRIPTDIR/../lib/trim.sh
. "${KS_LIB}/trim.sh"
# shellcheck source=SCRIPTDIR/../lib/walk.sh
. "${KS_LIB}/walk.sh"
# shellcheck source=SCRIPTDIR/../lib/process.sh
. "${KS_LIB}/process.sh"
# shellcheck source=SCRIPTDIR/../lib/rename.sh
. "${KS_LIB}/rename.sh"
# shellcheck source=SCRIPTDIR/../lib/compress.sh
. "${KS_LIB}/compress.sh"
# shellcheck source=SCRIPTDIR/../lib/run.sh
. "${KS_LIB}/run.sh"

ks_main() {
  ks_mn_count=$#
  ks_mn_literal=no
  while [ "${ks_mn_count}" -gt 0 ]; do
    ks_mn_arg="$1"
    shift
    ks_mn_count=$((ks_mn_count - 1))
    case "${ks_mn_literal}:${ks_mn_arg}" in
    no:--) ks_mn_literal=yes ;;
    no:--theme=*)
      KS_THEME="${ks_mn_arg#--theme=}"
      continue
      ;;
    no:--theme)
      [ "${ks_mn_count}" -gt 0 ] || ks_main_stop "option '--theme' needs a value"
      KS_THEME="$1"
      shift
      ks_mn_count=$((ks_mn_count - 1))
      continue
      ;;
    *) ;;
    esac
    set -- "$@" "${ks_mn_arg}"
  done
  ks_ui_setup || ks_main_fail "${KS_UI_PROBLEM}"
  ks_dispatch "$@"
}

ks_main_stop() {
  ks_cli_hint "$1"
  exit 1
}

ks_main_fail() {
  ks_error "$1"
  exit 1
}

ks_dispatch() {
  case "${1:-}" in
  help | -h | --help) ks_usage ;;
  version | -V | --version) ks_cli_version ;;
  doctor) ks_doctor ;;
  rename | compress)
    KS_MODE="$1"
    shift
    ks_start "$@"
    ;;
  *) ks_start "$@" ;;
  esac
}

ks_main "$@"
